# ===============================
# SERVER
# ===============================
SERVER_PORT=8090

# ===============================
# RABBITMQ (GLOBAL_CONFIG + GLOBAL_SECRET)
# ===============================
RABBITMQ_HOST=rabbitmq
RABBITMQ_STREAM_PORT=5552
RABBITMQ_STREAM_NAME=trade-stream
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# ===============================
# DATABASE (GLOBAL_CONFIG + GLOBAL_SECRET)
# ===============================
DB_HOST=postgres
DB_PORT=5432
DB_NAME=pmsdb
DB_USERNAME=pms
DB_PASSWORD=pms
DB_DRIVER=org.postgresql.Driver
DB_DIALECT=org.hibernate.dialect.PostgreSQLDialect
DB_DDL_AUTO=update
DB_SHOW_SQL=false
DB_FORMAT_SQL=true

# ===============================
# AUTH SERVICE (GLOBAL_CONFIG)
# ===============================
AUTH_SERVICE_HOST=auth
AUTH_SERVICE_PORT=8081

# ===============================
# DOWNSTREAM SERVICES (GLOBAL_CONFIG)
# ===============================
TRADE_CAPTURE_SERVICE_HOST=trade-capture
TRADE_CAPTURE_SERVICE_PORT=8082

# ===============================
# KAFKA (GLOBAL_CONFIG)
# ===============================
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
SCHEMA_REGISTRY_URL=http://schema-registry:8081

# ===============================
# KAFKA TOPICS (GLOBAL_CONFIG)
# ===============================
INCOMING_TRADES_TOPIC=raw-trades-topic
